{
  "schemaVersion": 1,
  "id": "Snap_Tap",
  "version": "${version}",
  "name": "SnapTap",
  "description": "SnapTap is a feature that prioritizes your newest keypress when two opposing directional keys are pressed at once, allowing instant direction changes without lifting a finger.",
  "authors": [
    "KingTux",
    "Siphalor"
  ],
  "provides": [
    "amecsapi"
  ],
  "contributors": [],
  "contact": {
    "sources": "${source_url}"
  },
  "license": "Apache-2.0",
  "icon": "assets/Snap_Tap/logo.png",
  "environment": "client",
  "entrypoints": {
    "main": [],
    "client": [
      {
        "adapter": "kotlin",
        "value": "dev.kingtux.tms.TooManyShortcuts"
      }
    ],
    "server": [],
    "modmenu": [
      "dev.kingtux.tms.modmenu.SnapTapModMenu"
    ]
  },
  "mixins": [
    "too_many_shortcuts.json"
  ],
  "accessWidener": "too_many_shortcuts.accesswidener",
  "depends": {
    "fabricloader": "${fabric_loader_range}",
    "minecraft": "${minecraft_range}",
    "fabric": "*",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}",
    "tms_core": "*",
    "tms_gui": "*",
    "tms_shortcuts": "*"
  },
  "custom": {
    "modmenu": {},
    "modmenu:clientsideOnly": true
  }
}
