{
  "schemaVersion": 1,
  "id": "too_many_shortcuts",
  "version": "${version}",
  "name": "SnapTap",
  "description": "Bind more than one key to the same action. The + button only appears when you hover a row, or always or never if you prefer, in SnapTap settings.",
  "authors": [
    "KingTux",
    "Siphalor"
  ],
  "provides": [
    "amecsapi"
  ],
  "contributors": [],
  "contact": {
    "sources": "${source_url}"
  },
  "license": "Apache-2.0",
  "icon": "assets/too_many_shortcuts/logo.png",
  "environment": "client",
  "entrypoints": {
    "main": [],
    "client": [
      {
        "adapter": "kotlin",
        "value": "dev.kingtux.tms.TooManyShortcuts"
      }
    ],
    "server": [],
    "modmenu": [
      "dev.kingtux.tms.modmenu.SnapTapModMenu"
    ]
  },
  "mixins": [
    "too_many_shortcuts.json"
  ],
  "accessWidener": "too_many_shortcuts.accesswidener",
  "depends": {
    "fabricloader": "${fabric_loader_range}",
    "minecraft": "${minecraft_range}",
    "fabric": "*",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}",
    "tms_core": "*",
    "tms_gui": "*",
    "tms_shortcuts": "*"
  },
  "custom": {
    "modmenu": {},
    "modmenu:clientsideOnly": true
  }
}
