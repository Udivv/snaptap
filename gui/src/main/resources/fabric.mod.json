{
  "schemaVersion": 1,
  "id": "${module_id}",
  "version": "${version}",
  "name": "SnapTap GUI",
  "description": "SnapTap controls screen",
  "authors": [
    "KingTux"
  ],
  "contributors": [],
  "contact": {
    "sources": "${source_url}"
  },
  "license": "Apache-2.0",
  "environment": "client",
  "<% if (project.hasProperty('access_widener')) { %>accessWidener": "${access_widener}.accesswidener",
  "<% } %>depends": {
    "fabricloader": "${fabric_loader_range}",
    "fabric": "*",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}",
    "minecraft": "${minecraft_range}"
  },
  "<% if (project.hasProperty('mixin')) { %>mixins": [
    "${mixin}.mixins.json"
  ],
  "<% } %>custom": {
    "modmenu:clientsideOnly": true,
    "modmenu": {
      "parent": "too_many_shortcuts",
      "badges": [
        "library"
      ]
    }
  }
}